---
const skillsData = [
  {
    category: "Languages",
    description: "Core programming languages I work with daily",
    items: ["Python", "JavaScript", "TypeScript", "C++"],
    proficiency: "Advanced"
  },
  {
    category: "Frontend",
    description: "Building responsive & interactive user experiences",
    items: ["React", "Next.js", "Astro.js", "Three.js", "Tailwind"],
    proficiency: "Expert"
  },
  {
    category: "Backend",
    description: "Server-side development & API architecture",
    items: ["Node.js", "Hono.js", "RESTful APIs"],
    proficiency: "Intermediate"
  },
  {
    category: "Cloud & Infrastructure",
    description: "Deployment & scaling solutions",
    items: ["Cloudflare", "AWS", "MongoDB", "Docker"],
    proficiency: "Advanced"
  }
];
---

<section id="skills" class="skills-snapshot">
  <div class="container">
    <header class="section-header">
      <h2 class="section-title">Technical Expertise</h2>
      <p class="section-subtitle">A curated overview of my technical capabilities and tools I use to build solutions.</p>
    </header>

    <div class="skills-grid">
      {skillsData.map(({ category, description, items, proficiency }) => (
        <article class="skill-card">
          <div class="skill-card__header">
            <h3 class="skill-card__title">{category}</h3>
            <span class="skill-card__badge">{proficiency}</span>
          </div>
          <p class="skill-card__description">{description}</p>
          <ul class="skill-card__list">
            {items.map(skill => (
              <li class="skill-item">{skill}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-snapshot {
    padding-block: 6rem;
    background-color: var(--clr-surface);
  }

  .container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .section-header {
    text-align: center;
    max-width: 65ch;
    margin-inline: auto;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2.5rem;
    color: var(--clr-text-heading);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .section-subtitle {
    color: var(--clr-text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .skill-card {
    background-color: var(--clr-background);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
    border: 1px solid var(--clr-border);
  }

  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.1);
  }

  .skill-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .skill-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--clr-text-heading);
    margin: 0;
  }

  .skill-card__badge {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    background-color: var(--clr-primary-50);
    color: var(--clr-primary-700);
  }

  .skill-card__description {
    color: var(--clr-text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .skill-card__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .skill-item {
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    background-color: var(--clr-background-alt);
    border-radius: 6px;
    color: var(--clr-text-body);
    transition: all 0.2s ease;
  }

  .skill-item:hover {
    background-color: var(--clr-primary-50);
    color: var(--clr-primary-700);
  }

  @media (max-width: 768px) {
    .skills-snapshot {
      padding-block: 4rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .skill-card {
      padding: 1.5rem;
    }
  }
</style>