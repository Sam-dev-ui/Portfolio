---
const placeholderImage = "https://images.unsplash.com/photo-1742943892619-501567da0c62?q=80&w=2069&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D";
const imageAlt = "Abstract technological background image";
---

<section id="about" class="hero-about">
  <div class="container">
    <div class="hero-about__grid">
      <div class="hero-about__content">
        <span class="hero-about__eyebrow">Hello, I'm a</span>
        <h1 class="hero-about__title">Full-Stack Developer_</h1>
        <p class="hero-about__text">
          Physics graduate crafting elegant digital solutions through code.
        </p>
        <div class="hero-about__cta-group">
          <a href="/projects" class="button button--primary">Projects →</a>
          <a href="/contact" class="button button--secondary">Contact</a>
        </div>
        <div class="hero-about__tech-stack">
          <div class="tech-icons">
            <!-- Add minimal tech icons -->
            <span class="tech-pill">React</span>
            <span class="tech-pill">Node.js</span>
            <span class="tech-pill">TypeScript</span>
          </div>
        </div>
      </div>
      <div class="hero-about__image-wrapper">
        <img
          src={placeholderImage}
          alt={imageAlt}
          class="hero-about__image"
          width="2069"
          height="1379"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-about {
    padding-block: 5rem;
    background-color: var(--clr-background);
    position: relative;
  }

  .container {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .hero-about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .hero-about__eyebrow {
    font-size: 1.125rem;
    color: var(--clr-text-muted);
    margin-bottom: 0.5rem;
    display: block;
  }

  .hero-about__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1;
    margin-bottom: 1.5rem;
    color: var(--clr-text-heading);
    font-weight: 700;
  }

  .hero-about__text {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--clr-text-body);
    margin-bottom: 2rem;
    max-width: 45ch;
  }

  .hero-about__cta-group {
    display: flex;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .button {
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button--primary {
    background-color: var(--clr-primary);
    color: var(--clr-background);
  }

  .button--secondary {
    color: var(--clr-text-heading);
    border: 1px solid var(--clr-text-heading);
  }

  .tech-icons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tech-pill {
    padding: 0.4rem 0.8rem;
    border-radius: 100px;
    background-color: var(--clr-background-alt);
    color: var(--clr-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .hero-about__image-wrapper {
    border-radius: 8px;
    overflow: hidden;
    opacity: 0.9;
  }

  .hero-about__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%);
    transition: filter 0.3s ease;
  }

  .hero-about__image:hover {
    filter: grayscale(0%);
  }

  @media (min-width: 768px) {
    .hero-about__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-about {
      padding-block: 6rem;
    }
  }
</style>