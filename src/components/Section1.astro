---
const placeholderImage = "https://images.unsplash.com/photo-1742943892619-501567da0c62?q=80&w=2069&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D";
const imageAlt = "Abstract technological background image";
---

<section id="about" class="hero-about">
  <div class="container">
    <div class="hero-about__grid">
      <div class="hero-about__content">
        <span class="hero-about__eyebrow">Full-Stack Developer</span>
        <h1 class="hero-about__title">Turning Complex Problems into Elegant Solutions</h1>
        <p class="hero-about__text">
          Physics graduate turned Full-Stack Developer with expertise in modern web technologies. 
          Leveraging analytical thinking and technical skills to build high-performance applications 
          that make a difference.
        </p>
        <div class="hero-about__cta-group">
          <a href="/projects" class="button button--primary">View My Work</a>
          <a href="/contact" class="button button--secondary">Get in Touch</a>
        </div>
        <div class="hero-about__tech-stack">
          <span class="tech-label">Tech Stack:</span>

        </div>
      </div>
      <div class="hero-about__image-wrapper">
        <img
          src={placeholderImage}
          alt={imageAlt}
          width="2069"
          height="1379"
          loading="eager"
          decoding="async"
          class="hero-about__image"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-about {
    padding-block: 6rem;
    background-color: var(--clr-background);
    position: relative;
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .hero-about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-about__eyebrow {
    display: inline-block;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-primary);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .hero-about__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--clr-text-heading);
  }

  .hero-about__text {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--clr-text-body);
    margin-bottom: 2rem;
    max-width: 55ch;
  }

  .hero-about__cta-group {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    padding: 0.875rem 1.75rem;
    border-radius: var(--border-radius-sm);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .button--primary {
    background-color: var(--clr-primary);
    color: var(--clr-background);
  }

  .button--secondary {
    background-color: transparent;
    color: var(--clr-text-heading);
    border: 2px solid var(--clr-text-heading);
  }

  .hero-about__tech-stack {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .tech-label {
    font-size: 0.875rem;
    color: var(--clr-text-muted);
  }

  .tech-icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .tech-icons img {
    width: 24px;
    height: 24px;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .tech-icons img:hover {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .hero-about__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
    }

    .hero-about__content {
      order: 1;
    }

    .hero-about__image-wrapper {
      order: 2;
    }
  }

  @media (min-width: 1024px) {
    .hero-about {
      padding-block: 8rem;
    }
  }
</style>