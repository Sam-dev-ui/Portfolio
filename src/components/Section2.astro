---
// src/components/SkillsSnapshot.astro

// Structure skills data for easier iteration (optional but good practice)
const skillsData = [
  {
    category: "Languages",
    items: ["Python", "JavaScript", "TypeScript", "WEBGL", "C++", "C", "React Native", "Flutter"]
  },
  {
    category: "Frontend",
    items: ["React", "Next.js", "Astro.js", "Three.js", "R3F", "Tailwind", "HTML/CSS"]
  },
  {
    category: "Backend",
    items: ["Hono.js"]
  },
  {
    category: "Cloud & Databases",
    items: ["Cloudflare (Workers, Pages, D1, KV)", "AWS (Lambda, S3)", "Google Cloud", "MongoDB", "Upstash Redis", "Hostinger VPS"]
  },
  {
    category: "Tools & Tech",
    items: ["Git", "Docker", "shadcn", "Figma", "VS Code", "Unity 3D", "Blender"]
  }
];
---

<section id="skills" class="skills-snapshot">
  <div class="container">
    <h2 class="skills-snapshot__title">Skills Snapshot</h2>
    <div class="skills-snapshot__grid">
      {skillsData.map(skillGroup => (
        <div class="skills-snapshot__category-card">
          <h3 class="skills-snapshot__category-title">{skillGroup.category}</h3>
          <ul class="skills-snapshot__list">
            {skillGroup.items.map(skill => (
              <li class="skills-snapshot__item">{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-snapshot {
    padding-block: 4rem;
    background-color: var(--clr-surface); /* Slightly different background */
  }

  .container {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .skills-snapshot__title {
    text-align: center;
    color: var(--clr-text-heading);
    margin-bottom: 2.5rem; /* More space below title */
    font-size: 1.875rem; /* h2 */
  }

  .skills-snapshot__grid {
    display: grid;
    /* Responsive grid: automatically fit columns */
    /* - Min width: 250px */
    /* - Max width: 1fr (take up equal space) */
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem; /* Gap between cards */
  }

  .skills-snapshot__category-card {
    background-color: var(--clr-background); /* Card background */
    padding: 1.5rem;
    border-radius: var(--border-radius-md);
    border: 1px solid var(--clr-border);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-fast);
  }

  .skills-snapshot__category-card:hover {
     box-shadow: var(--shadow-md);
  }

  .skills-snapshot__category-title {
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--clr-primary-500); /* Use primary color for category titles */
    font-size: 1.125rem; /* Slightly smaller than h4 */
    font-weight: 600;
    border-bottom: 1px solid var(--clr-border); /* Separator line */
    padding-bottom: 0.5rem;
  }

  .skills-snapshot__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex; /* Arrange skills horizontally */
    flex-wrap: wrap; /* Allow skills to wrap to the next line */
    gap: 0.5rem; /* Space between skill items */
  }

  .skills-snapshot__item {
    background-color: var(--clr-neutral-100); /* Tag background */
    color: var(--clr-neutral-800); /* Tag text */
    padding: 0.25rem 0.75rem; /* Padding inside tag */
    border-radius: var(--border-radius-sm);
    font-size: 0.875rem; /* Slightly smaller font for tags */
    line-height: 1.4;
    border: 1px solid var(--clr-border);
    white-space: nowrap; /* Prevent tags from breaking mid-word */
  }

  /* Responsive Adjustments */
  @media (min-width: 768px) {
    .skills-snapshot__title {
      font-size: 2.25rem; /* Larger title on desktop */
    }
     .skills-snapshot__grid {
        gap: 2rem; /* Increase gap on larger screens */
    }
  }

</style>